#!/usr/bin/make -f

PKG := debian/sm-elite

%:
	dh $@

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests
endif

override_dh_install:
	dh_install -X__pycache__ -X.pyc

execute_after_dh_install:
	install -D -m 0644 deploy/apache-sm-elite.conf $(PKG)/etc/apache2/conf-available/sm-elite.conf
	sed -i 's/@PORT@/8420/g' $(PKG)/etc/apache2/conf-available/sm-elite.conf
	install -D -m 0440 debian/sudoers $(PKG)/etc/sudoers.d/sm-elite

execute_after_dh_fixperms:
	chmod 0440 $(PKG)/etc/sudoers.d/sm-elite
	chmod 0755 $(PKG)/usr/lib/sm-elite/smelite-admin
