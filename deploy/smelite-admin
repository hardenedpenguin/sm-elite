#!/usr/bin/python3
"""Root helper for SM-Elite admin tools. Install as root:root 0755 and allow
only this path in sudoers. It accepts a fixed set of actions and file names.

    smelite-admin check
    smelite-admin write <name> <sha256-of-current-file>   (new text on stdin)
    smelite-admin reboot
    smelite-admin poweroff
    smelite-admin backups <name>
    smelite-admin backup-show <name> <stamp>
    smelite-admin restore <name> <stamp> <sha256-of-current-file>
    smelite-admin sound-save <name>     (8 kHz mu-law audio on stdin)
    smelite-admin sound-delete <name>
    smelite-admin bridge-restart        (DVSwitch mmdvm_bridge* and analog_bridge* units)
    smelite-admin node-status           (run sm-elite-node-status.service now)
    smelite-admin config-write <name>   (a file for /etc/sm-elite from a settings backup, on stdin)
    smelite-admin restart-dashboard     (restart sm-elite.service in 3 seconds)
"""

import grp
import hashlib
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

FILES = {
    "rpt.conf": Path("/etc/asterisk/rpt.conf"),
    "iax.conf": Path("/etc/asterisk/iax.conf"),
    "extensions.conf": Path("/etc/asterisk/extensions.conf"),
    "asdb.txt": Path("/etc/sm-elite/asdb.txt"),
    "node_info.ini": Path("/etc/sm-elite/node_info.ini"),
}
SMELITE_DIR = Path("/etc/sm-elite")
SERVICE_USER = "smelite"
CONFIG_NAME = re.compile(r"(smelite|nodes|commands|dvswitch|node_info|favorites[A-Za-z0-9_-]{0,40})\.ini|asdb\.txt")
BACKUPS = Path("/var/backups/smelite")
KEEP_BACKUPS = 20
MAX_BYTES = 1024 * 1024
ANNOUNCEMENTS = Path("/usr/local/share/asterisk/sounds/announcements")
SOUND_NAME = re.compile(r"[a-z0-9][a-z0-9_-]{0,39}")
MAX_SOUND_BYTES = 8000 * 600
STAMP = re.compile(r"\d{8}-\d{6}(\.\d{3})?")
BRIDGE_UNIT = re.compile(r"(mmdvm|analog)_bridge\d*\.service")


def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    sys.exit(code)


def write(name: str, expected: str) -> None:
    replace(name, expected, sys.stdin.buffer.read(MAX_BYTES + 1))


def backup_path(name: str, stamp: str) -> Path:
    if name not in FILES or not STAMP.fullmatch(stamp):
        fail("unknown backup")
    path = BACKUPS / f"{name}.{stamp}"
    if not path.is_file() or path.is_symlink():
        fail("unknown backup")
    return path


def list_backups(name: str) -> None:
    if name not in FILES:
        fail("unknown file")
    for path in sorted(BACKUPS.glob(f"{name}.*"), reverse=True):
        stamp = path.name[len(name) + 1:]
        if STAMP.fullmatch(stamp) and path.is_file():
            print(f"{stamp}\t{path.stat().st_size}")


def show_backup(name: str, stamp: str) -> None:
    sys.stdout.buffer.write(backup_path(name, stamp).read_bytes())


def restore(name: str, stamp: str, expected: str) -> None:
    replace(name, expected, backup_path(name, stamp).read_bytes())


def check_text(data: bytes) -> None:
    if len(data) > MAX_BYTES:
        fail("file is too large")
    if b"\x00" in data:
        fail("file contains a NUL byte")
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        fail("file is not valid UTF-8")


def replace(name: str, expected: str, data: bytes) -> None:
    target = FILES.get(name)
    if target is None:
        fail("unknown file")
    check_text(data)
    current = target.read_bytes() if target.is_file() else b""
    if hashlib.sha256(current).hexdigest() != expected:
        fail("the file changed since it was loaded; reload it and try again", 3)
    install(target, name, data, (-1, -1, 0o644))


def config_write(name: str) -> None:
    """Put one file from a settings backup into /etc/sm-elite, owned like setup leaves it."""
    if not CONFIG_NAME.fullmatch(name):
        fail("unknown file")
    target = SMELITE_DIR / name
    if target.is_symlink() or (target.exists() and not target.is_file()):
        fail("unknown file")
    data = sys.stdin.buffer.read(MAX_BYTES + 1)
    check_text(data)
    gid = grp.getgrnam(SERVICE_USER).gr_gid
    if name.startswith("favorites"):
        owner = (pwd.getpwnam(SERVICE_USER).pw_uid, gid, 0o644)
    elif name in ("asdb.txt", "node_info.ini", "commands.ini"):
        owner = (-1, -1, 0o644)
    else:
        owner = (-1, gid, 0o640)
    install(target, name, data, owner)


def install(target: Path, name: str, data: bytes, new_owner: tuple[int, int, int]) -> None:
    """Write data over target, keeping a backup and the current owner and mode.

    new_owner is (uid, gid, mode) for a new file; -1 leaves that id as root, which creates it.
    """
    exists = target.is_file()
    current = target.read_bytes() if exists else b""
    backup = "none (new file)"
    if exists:
        BACKUPS.mkdir(mode=0o700, parents=True, exist_ok=True)
        now = time.time()
        stamp = time.strftime("%Y%m%d-%H%M%S", time.gmtime(now)) + f".{int(now * 1000) % 1000:03d}"
        backup = BACKUPS / f"{name}.{stamp}"
        backup.write_bytes(current)
        os.chmod(backup, 0o600)
        for old in sorted(BACKUPS.glob(f"{name}.*"))[:-KEEP_BACKUPS]:
            old.unlink()

    info = target.stat() if exists else None
    fd, temp = tempfile.mkstemp(prefix=f".{name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        uid, gid, mode = (info.st_uid, info.st_gid, info.st_mode & 0o7777) if info is not None else new_owner
        if (uid, gid) != (os.geteuid(), os.getegid()) and (uid, gid) != (-1, -1):
            os.chown(temp, uid, gid)
        os.chmod(temp, mode)
        os.replace(temp, target)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise
    print(backup)


def sound_save(name: str) -> None:
    if not SOUND_NAME.fullmatch(name):
        fail("bad sound name")
    data = sys.stdin.buffer.read(MAX_SOUND_BYTES + 1)
    if not data or len(data) > MAX_SOUND_BYTES:
        fail("sound is empty or longer than 10 minutes")
    ANNOUNCEMENTS.mkdir(mode=0o2755, parents=True, exist_ok=True)
    target = ANNOUNCEMENTS / f"{name}.ulaw"
    fd, temp = tempfile.mkstemp(prefix=f".{name}.", dir=ANNOUNCEMENTS)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        os.chmod(temp, 0o644)
        os.replace(temp, target)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise
    print(target)


def sound_delete(name: str) -> None:
    if not SOUND_NAME.fullmatch(name):
        fail("bad sound name")
    removed = False
    for ext in (".ulaw", ".ul", ".gsm", ".wav", ".sln", ".alaw", ".g722"):
        path = ANNOUNCEMENTS / f"{name}{ext}"
        if path.is_file() and not path.is_symlink():
            path.unlink()
            removed = True
    if not removed:
        fail("no such announcement")
    print("deleted")


def bridge_units() -> list[str]:
    """Installed bridge units, MMDVM_Bridge before Analog_Bridge, e.g. mmdvm_bridge2."""
    out = subprocess.run(
        ["/usr/bin/systemctl", "list-unit-files", "--no-legend", "--plain", "mmdvm_bridge*.service", "analog_bridge*.service"],
        capture_output=True, text=True,
    ).stdout
    units = {line.split()[0] for line in out.splitlines() if line.strip()}
    return sorted((unit for unit in units if BRIDGE_UNIT.fullmatch(unit)), key=lambda unit: (not unit.startswith("mmdvm"), unit))


def bridge_restart() -> None:
    done, failed = [], []
    for unit in bridge_units():
        result = subprocess.run(["/usr/bin/systemctl", "restart", unit], capture_output=True, text=True)
        (done if result.returncode == 0 else failed).append(unit)
    if failed:
        fail(f"could not restart {', '.join(failed)}" + (f" (restarted {', '.join(done)})" if done else ""))
    if not done:
        fail("no DVSwitch bridge services (mmdvm_bridge, analog_bridge) on this system")
    print(f"restarted {', '.join(done)}")


def node_status() -> None:
    result = subprocess.run(
        ["/usr/bin/systemctl", "start", "--no-block", "sm-elite-node-status.service"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        fail(result.stderr.strip() or "could not start sm-elite-node-status.service")
    print("node status update started")


def restart_dashboard() -> None:
    subprocess.run(
        ["/usr/bin/systemd-run", "--on-active=3s", "--unit", "smelite-restart", "--collect",
         "/usr/bin/systemctl", "restart", "sm-elite.service"],
        check=True,
        stdout=subprocess.DEVNULL,
    )
    print("SM-Elite restarts in 3 seconds")


def power(verb: str) -> None:
    subprocess.run(
        ["/usr/bin/systemd-run", "--on-active=5s", "--unit", f"smelite-{verb}", "/usr/bin/systemctl", verb],
        check=True,
        stdout=subprocess.DEVNULL,
    )
    print(f"{verb} in 5 seconds")


def main(argv: list[str]) -> None:
    if os.geteuid() != 0:
        fail("must run as root")
    if argv == ["check"]:
        print("ok")
    elif len(argv) == 3 and argv[0] == "write":
        write(argv[1], argv[2])
    elif argv in (["reboot"], ["poweroff"]):
        power(argv[0])
    elif argv == ["bridge-restart"]:
        bridge_restart()
    elif argv == ["node-status"]:
        node_status()
    elif argv == ["restart-dashboard"]:
        restart_dashboard()
    elif len(argv) == 2 and argv[0] == "config-write":
        config_write(argv[1])
    elif len(argv) == 2 and argv[0] == "backups":
        list_backups(argv[1])
    elif len(argv) == 3 and argv[0] == "backup-show":
        show_backup(argv[1], argv[2])
    elif len(argv) == 4 and argv[0] == "restore":
        restore(argv[1], argv[2], argv[3])
    elif len(argv) == 2 and argv[0] == "sound-save":
        sound_save(argv[1])
    elif len(argv) == 2 and argv[0] == "sound-delete":
        sound_delete(argv[1])
    else:
        fail("usage: smelite-admin check | write <name> <sha256> | reboot | poweroff"
             " | backups <name> | backup-show <name> <stamp> | restore <name> <stamp> <sha256>"
             " | sound-save <name> | sound-delete <name> | bridge-restart | node-status"
             " | config-write <name> | restart-dashboard", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
