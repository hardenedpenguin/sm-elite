[Unit]
Description=SM-Elite AllStar dashboard
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/python3 -m smelite --config @CONFIG@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
